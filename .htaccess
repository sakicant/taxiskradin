  RewriteRule ^pl/taxi-skradin-to-vodice/?$ /pl/skradin-transfers/ [R=301,L]
  RewriteRule ^pl/taxi-skradin-to-zadar/?$ /pl/skradin-transfers/ [R=301,L]
  RewriteRule ^pl/taxi-trogir-to-skradin/?$ /pl/skradin-transfers/ [R=301,L]
  RewriteRule ^pl/terms-and-conditions/?$ /pl/regulamin/ [R=301,L]
  RewriteRule ^pl/transfer-z-lotniska-ze-skradinu/?$ /pl/skradin-airport-transfers/ [R=301,L]
  RewriteRule ^pl/transfery-lotniskowe-skradin/?$ /pl/skradin-airport-transfers/ [R=301,L]
  RewriteRule ^pl/what-is-the-progressive-web-app-pwa-and-how-it-works/?$ /pl/ [R=301,L]
  RewriteRule ^sk/rezervacia/?$ /sk/book/ [R=301,L]
  RewriteRule ^sl/rezervacija/?$ /sl/book/ [R=301,L]
  RewriteRule ^sl/taksi-sibenik-skradin/?$ /sl/skradin-transfers/ [R=301,L]
  RewriteRule ^sr/rezervacija/?$ /sr/book/ [R=301,L]

  RewriteRule ^hr/taxi-zracna-luka-zadar-do-skradina/?$ /hr/skradin-airport-transfers/ [R=301,L]
  RewriteRule ^hr/web-design-trends-for-2022/?$ /hr/ [R=301,L]
  RewriteRule ^hu/foglalas/?$ /hu/book/ [R=301,L]
  RewriteRule ^it/prenota/?$ /it/book/ [R=301,L]
  RewriteRule ^ja/yoyaku/?$ /ja/book/ [R=301,L]
  RewriteRule ^ko/yeyak/?$ /ko/book/ [R=301,L]
  RewriteRule ^krka-transfers/?$ /krka-national-park-transfers/ [R=301,L]
  RewriteRule ^nl/boeken/?$ /nl/book/ [R=301,L]
  RewriteRule ^no/bestill/?$ /no/book/ [R=301,L]
  RewriteRule ^pl/czym-jest-progresywna-aplikacja-internetowa-pwa-i-jak-dziala/?$ /pl/ [R=301,L]
